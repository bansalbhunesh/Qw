# Alibaba Cloud Model Studio (DashScope) — international endpoint
DASHSCOPE_API_KEY=sk-your-key-here

# Optional model overrides (defaults chosen for the budget tiers)
# AUTEUR_MODEL_GRUNT=qwen-flash
# AUTEUR_MODEL_CREATIVE=qwen-max
# AUTEUR_MODEL_VISION=qwen-vl-max
# AUTEUR_MODEL_WAN_T2V=wan2.7-t2v
# AUTEUR_MODEL_WAN_I2V=wan2.7-i2v
# AUTEUR_MODEL_TTS=cosyvoice-v2

# Alibaba Cloud OSS (asset storage) — needed for cloud deployment
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=oss-ap-southeast-1.aliyuncs.com
