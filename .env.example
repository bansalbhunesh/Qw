# Alibaba Cloud Model Studio (DashScope) — international endpoint
DASHSCOPE_API_KEY=sk-your-key-here

# Model overrides — defaults are the latest generation as of June 2026
# AUTEUR_MODEL_GRUNT=qwen3-flash          # cheap/fast tier (default)
# AUTEUR_MODEL_CREATIVE=qwen3-max         # creative reasoning tier (default)
# AUTEUR_MODEL_VISION=qwen-vl-max         # vision critic tier (default)
# AUTEUR_MODEL_WAN_T2V=wan2.7-t2v         # text-to-video (default — needs paid billing)
# AUTEUR_MODEL_WAN_I2V=wan2.7-i2v         # image-to-video for continuity (default)
# AUTEUR_MODEL_TTS=cosyvoice-v2           # text-to-speech (default)

# Free-tier fallbacks (use these if you get 403 FreeTierOnly errors on Wan 2.7):
# AUTEUR_MODEL_WAN_T2V=wan2.2-t2v-plus
# AUTEUR_MODEL_WAN_I2V=wan2.2-i2v-plus
# AUTEUR_MODEL_TTS=cosyvoice-v3-plus

# Alibaba Cloud OSS (asset storage) — needed for i2v continuity chaining in production
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=oss-ap-southeast-1.aliyuncs.com
