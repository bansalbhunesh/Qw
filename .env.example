# ═══════════════════════════════════════════════════════════════════════════════
# Auteur — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values below.
#   cp .env.example .env
#
# For mock mode (no API key, zero spend), just leave DASHSCOPE_API_KEY empty
# or set AUTEUR_MOCK=1. The full pipeline runs offline with deterministic
# placeholder outputs.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Alibaba Cloud Model Studio (DashScope) ──────────────────────────────────
# Your DashScope API key from the Alibaba Cloud console.
# International endpoint: https://dashscope-intl.aliyuncs.com
# Get your key at: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=sk-your-key-here

# ─── Mock Mode ────────────────────────────────────────────────────────────────
# Set to 1 to run the full pipeline without any API calls or spend.
# Automatically enabled when DASHSCOPE_API_KEY is missing.
# Mock mode uses MockTransport for deterministic LLM responses and
# ffmpeg-synthesized placeholder clips — same code paths as live.
# AUTEUR_MOCK=1

# ─── Model Overrides ─────────────────────────────────────────────────────────
# Auteur uses three LLM tiers (grunt / creative / vision) plus video and TTS.
# Defaults are the latest generation as of June 2026. Override any model below.
#
# GRUNT tier — cheap, fast tasks (prompt formatting, shot list cleanup, mood pick)
# AUTEUR_MODEL_GRUNT=qwen3-flash
#
# CREATIVE tier — high-quality reasoning (script writing, art direction, retake decisions)
# AUTEUR_MODEL_CREATIVE=qwen3-max
#
# VISION tier — multimodal critic (4-axis scoring of rendered frames)
# AUTEUR_MODEL_VISION=qwen-vl-max
#
# TEXT-TO-VIDEO — primary video generation model
# AUTEUR_MODEL_WAN_T2V=wan2.7-t2v           # Requires paid billing
#
# IMAGE-TO-VIDEO — continuity chaining (final frame → next shot seed)
# AUTEUR_MODEL_WAN_I2V=wan2.7-i2v           # Requires paid billing
#
# TEXT-TO-SPEECH — dialogue voicing via CosyVoice
# AUTEUR_MODEL_TTS=cosyvoice-v2

# ─── Free-Tier Fallbacks ─────────────────────────────────────────────────────
# If you hit 403 FreeTierOnly errors on Wan 2.7, switch to these models:
# AUTEUR_MODEL_WAN_T2V=wan2.2-t2v-plus
# AUTEUR_MODEL_WAN_I2V=wan2.2-i2v-plus
# AUTEUR_MODEL_TTS=cosyvoice-v3-plus

# ─── Alibaba Cloud OSS (Object Storage) ──────────────────────────────────────
# Required for image-to-video (i2v) continuity chaining in live production.
# Anchor frames are uploaded to OSS so the Wan API can reference them.
# Not needed for mock mode or text-to-video only runs.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=oss-ap-southeast-1.aliyuncs.com

# ─── Budget Controls (CLI flags also available) ──────────────────────────────
# These can also be set via CLI flags (--max-spend-usd, --quality-gate, etc.)
# but env vars provide persistent defaults.
#
# Hard USD spend cap — stops rendering before exceeding this (default: $2.00)
# AUTEUR_MAX_SPEND_USD=2.00
#
# Minimum critic score to keep a shot in the final cut (default: 0, keeps all)
# AUTEUR_QUALITY_GATE=0
#
# Total token budget ceiling (default: 120000)
# AUTEUR_TOKEN_BUDGET=120000
